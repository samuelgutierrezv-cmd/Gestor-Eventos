<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.samuel.gestor_eventos.controler.PagoControler"
            prefWidth="900"
            prefHeight="650">

    <top>
        <VBox spacing="10" style="-fx-padding: 20;">

            <Label text="Pago de Entradas"
                   style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

            <Label fx:id="lblEventoNombre"
                   style="-fx-font-size: 20px;"/>

            <Label fx:id="lblEventoDetalle"/>

            <Label fx:id="lblEventoRecinto"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="15"
              alignment="CENTER"
              style="-fx-padding: 20;">

            <Label fx:id="lblZona"
                   style="-fx-font-size: 18px;"/>

            <Label fx:id="lblPrecioEntrada"
                   style="-fx-font-size: 18px;"/>

            <HBox spacing="10" alignment="CENTER">

                <Button text="-"
                        onAction="#decrementar"/>

                <Label fx:id="lblCantidad"
                       text="1"
                       style="-fx-font-size: 18px;"/>

                <Button text="+"
                        onAction="#incrementar"/>

            </HBox>

            <Label text="Método de pago"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <HBox spacing="10" alignment="CENTER">

                <Button text="Tarjeta"
                        onAction="#seleccionarTarjetaCredito"/>

                <Button text="Nequi"
                        onAction="#seleccionarNequi"/>

                <Button text="Daviplata"
                        onAction="#seleccionarDaviplata"/>

            </HBox>

            <Label fx:id="lblMetodoSeleccionado"
                   text="Tarjeta de Crédito"/>

            <Separator/>
            <Label fx:id="lblSubtotal" text="Subtotal:"/>
            <Label fx:id="lblResumenSubtotal"/>

            <Label fx:id="lblResumenCargo"/>

            <Label fx:id="lblResumenTotal"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="20"
              alignment="CENTER"
              style="-fx-padding: 20;">

            <Button text="Volver"
                    fx:id="btnVolver"
                    onAction="#volver"/>

            <Button text="Confirmar compra"
                    onAction="#confirmarCompra"/>

        </HBox>
    </bottom>

</BorderPane>