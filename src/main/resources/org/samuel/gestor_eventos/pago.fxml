<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>

<VBox
        prefHeight="680.0"
        prefWidth="920.0"
        styleClass="pane-principal"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.samuel.gestor_eventos.controler.PagoControler"
        stylesheets="@pago.css"
        spacing="0">

    <!-- ══ HEADER ══ -->
    <HBox styleClass="header" spacing="16">
        <Button text="← Volver" fx:id="btnVolver" styleClass="button-back" onAction="#volver" />
        <Label text="🎫  Comprar Entrada" styleClass="header-title"/>
        <StackPane HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotalHeader" text="Total: $0" styleClass="header-total"/>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="24" styleClass="scroll-content">

            <!-- ══ RESUMEN DEL EVENTO ══ -->
            <VBox styleClass="seccion-card" spacing="10">
                <Label text="Resumen del evento" styleClass="seccion-titulo"/>
                <HBox styleClass="evento-resumen-box" spacing="20">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblEventoNombre"   text="Festival Estéreo Picnic" styleClass="resumen-nombre"/>
                        <Label fx:id="lblEventoDetalle"  text="📍 Bogotá  ·  📅 15 May 2025  ·  🕐 16:00" styleClass="resumen-detalle"/>
                        <Label fx:id="lblEventoRecinto"  text="🏟 Anfiteatro del Lago" styleClass="resumen-detalle"/>
                    </VBox>
                    <VBox styleClass="resumen-precio-box" spacing="4">
                        <Label text="Precio por entrada" styleClass="resumen-precio-label"/>
                        <Label fx:id="lblPrecioEntrada" text="120.000" styleClass="resumen-precio-valor"/>
                        <Label fx:id="lblZona"          text="Zona: General" styleClass="resumen-zona"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ══ CANTIDAD ══ -->
            <VBox styleClass="seccion-card" spacing="12">
                <Label text="Cantidad de entradas" styleClass="seccion-titulo"/>
                <HBox spacing="16" styleClass="cantidad-row">
                    <Button text="−" styleClass="btn-cantidad" onAction="#decrementar"/>
                    <Label fx:id="lblCantidad" text="1" styleClass="cantidad-num"/>
                    <Button text="+" styleClass="btn-cantidad" onAction="#incrementar"/>
                    <StackPane HBox.hgrow="ALWAYS"/>
                    <VBox styleClass="subtotal-box" spacing="2">
                        <Label text="Subtotal" styleClass="subtotal-label"/>
                        <Label fx:id="lblSubtotal" text="120.000" styleClass="subtotal-valor"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ══ FORMA DE COMPRA ══ -->
            <VBox styleClass="seccion-card" spacing="14">
                <Label text="¿Cómo quieres comprar?" styleClass="seccion-titulo"/>
                <HBox spacing="14">

                    <!-- Opción: Compra en línea -->
                    <VBox styleClass="opcion-card opcion-selected" onMouseClicked="#seleccionarCompraEnLinea"
                          spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🌐" styleClass="opcion-icon"/>
                        <Label text="En línea" styleClass="opcion-titulo"/>
                        <Label text="Paga desde tu dispositivo de forma rápida y segura"
                               styleClass="opcion-desc" wrapText="true"/>
                        <Label fx:id="lblSelEnLinea" text="✔ Seleccionado" styleClass="opcion-check"/>
                    </VBox>

                    <!-- Opción: Punto físico -->
                    <VBox styleClass="opcion-card" onMouseClicked="#seleccionarPuntoFisico"
                          spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🏪" styleClass="opcion-icon"/>
                        <Label text="Punto físico" styleClass="opcion-titulo"/>
                        <Label text="Dirígete a uno de nuestros puntos autorizados y paga en efectivo"
                               styleClass="opcion-desc" wrapText="true"/>
                        <Label fx:id="lblSelFisico" text="" styleClass="opcion-check"/>
                    </VBox>

                    <!-- Opción: Taquilla evento -->
                    <VBox styleClass="opcion-card" onMouseClicked="#seleccionarTaquilla"
                          spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="🎟" styleClass="opcion-icon"/>
                        <Label text="Taquilla" styleClass="opcion-titulo"/>
                        <Label text="Compra directamente en la taquilla del evento el día del show"
                               styleClass="opcion-desc" wrapText="true"/>
                        <Label fx:id="lblSelTaquilla" text="" styleClass="opcion-check"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ══ MÉTODO DE PAGO ══ -->
            <VBox styleClass="seccion-card" spacing="14">
                <Label text="Método de pago" styleClass="seccion-titulo"/>

                <!-- Grid de métodos -->
                <GridPane hgap="12" vgap="12">

                    <!-- Tarjeta de crédito -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0"
                          styleClass="metodo-card metodo-selected"
                          onMouseClicked="#seleccionarTarjetaCredito"
                          spacing="6" prefWidth="190">
                        <Label text="💳" styleClass="metodo-icon"/>
                        <Label text="Tarjeta de Crédito" styleClass="metodo-titulo"/>
                        <Label text="Visa · Mastercard · Amex" styleClass="metodo-desc"/>
                    </VBox>

                    <!-- Tarjeta de débito -->
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0"
                          styleClass="metodo-card"
                          onMouseClicked="#seleccionarTarjetaDebito"
                          spacing="6" prefWidth="190">
                        <Label text="🏦" styleClass="metodo-icon"/>
                        <Label text="Tarjeta de Débito" styleClass="metodo-titulo"/>
                        <Label text="Débito bancario inmediato" styleClass="metodo-desc"/>
                    </VBox>

                    <!-- PSE -->
                    <VBox GridPane.columnIndex="2" GridPane.rowIndex="0"
                          styleClass="metodo-card"
                          onMouseClicked="#seleccionarPSE"
                          spacing="6" prefWidth="190">
                        <Label text="🏛" styleClass="metodo-icon"/>
                        <Label text="PSE" styleClass="metodo-titulo"/>
                        <Label text="Transferencia bancaria en línea" styleClass="metodo-desc"/>
                    </VBox>

                    <!-- Nequi -->
                    <VBox GridPane.columnIndex="3" GridPane.rowIndex="0"
                          styleClass="metodo-card"
                          onMouseClicked="#seleccionarNequi"
                          spacing="6" prefWidth="190">
                        <Label text="📱" styleClass="metodo-icon"/>
                        <Label text="Nequi" styleClass="metodo-titulo"/>
                        <Label text="Paga con tu billetera digital" styleClass="metodo-desc"/>
                    </VBox>

                    <!-- Efectivo -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="1"
                          styleClass="metodo-card"
                          onMouseClicked="#seleccionarEfectivo"
                          spacing="6" prefWidth="190">
                        <Label text="💵" styleClass="metodo-icon"/>
                        <Label text="Efectivo" styleClass="metodo-titulo"/>
                        <Label text="Paga en punto físico o taquilla" styleClass="metodo-desc"/>
                    </VBox>

                    <!-- Daviplata -->
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="1"
                          styleClass="metodo-card"
                          onMouseClicked="#seleccionarDaviplata"
                          spacing="6" prefWidth="190">
                        <Label text="🔴" styleClass="metodo-icon"/>
                        <Label text="Daviplata" styleClass="metodo-titulo"/>
                        <Label text="Billetera Davivienda" styleClass="metodo-desc"/>
                    </VBox>

                    <!-- QR / Código -->
                    <VBox GridPane.columnIndex="2" GridPane.rowIndex="1"
                          styleClass="metodo-card"
                          onMouseClicked="#seleccionarQR"
                          spacing="6" prefWidth="190">
                        <Label text="📷" styleClass="metodo-icon"/>
                        <Label text="Código QR" styleClass="metodo-titulo"/>
                        <Label text="Escanea y paga en segundos" styleClass="metodo-desc"/>
                    </VBox>

                    <!-- Cuotas -->
                    <VBox GridPane.columnIndex="3" GridPane.rowIndex="1"
                          styleClass="metodo-card"
                          onMouseClicked="#seleccionarCuotas"
                          spacing="6" prefWidth="190">
                        <Label text="📆" styleClass="metodo-icon"/>
                        <Label text="Pago en cuotas" styleClass="metodo-titulo"/>
                        <Label text="Hasta 36 cuotas sin interés" styleClass="metodo-desc"/>
                    </VBox>

                </GridPane>

                <!-- Indicador de método seleccionado -->
                <HBox styleClass="metodo-seleccionado-row" spacing="8">
                    <Label text="Método elegido:" styleClass="metodo-sel-label"/>
                    <Label fx:id="lblMetodoSeleccionado" text="Tarjeta de Crédito" styleClass="metodo-sel-valor"/>
                </HBox>
            </VBox>

            <!-- ══ RESUMEN FINAL ══ -->
            <VBox styleClass="seccion-card resumen-final" spacing="10">
                <HBox>
                    <Label text="Subtotal entradas" styleClass="resumen-linea-label"/>
                    <StackPane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblResumenSubtotal" text="120.000" styleClass="resumen-linea-valor"/>
                </HBox>
                <HBox>
                    <Label text="Cargo por servicio (10%)" styleClass="resumen-linea-label"/>
                    <StackPane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblResumenCargo" text="12.000" styleClass="resumen-linea-valor"/>
                </HBox>
                <Separator styleClass="resumen-sep"/>
                <HBox>
                    <Label text="TOTAL" styleClass="resumen-total-label"/>
                    <StackPane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblResumenTotal" text="123132" styleClass="resumen-total-valor"/>
                </HBox>
            </VBox>

            <!-- ══ BOTÓN CONFIRMAR ══ -->
            <HBox styleClass="footer-acciones" spacing="14">
                <Button text="Cancelar"         styleClass="button-secondary" onAction="#cancelar" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Confirmar compra" styleClass="button-confirmar" onAction="#confirmarCompra" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

        </VBox>
    </ScrollPane>

</VBox>