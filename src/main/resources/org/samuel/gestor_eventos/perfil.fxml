<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.samuel.gestor_eventos.controler.PerfilController"
      prefWidth="600"
      prefHeight="500"
      stylesheets="@admin.css">

    <Label text="Mi Perfil"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <VBox spacing="10"
          style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #334155; -fx-border-radius: 15;">
        <Label fx:id="lblNombre" style="-fx-text-fill: #e2e8f0; -fx-font-size: 16px;"/>
        <Label fx:id="lblCorreo" style="-fx-text-fill: #e2e8f0; -fx-font-size: 16px;"/>
        <Label fx:id="lblTelefono" style="-fx-text-fill: #e2e8f0; -fx-font-size: 16px;"/>
    </VBox>

    <Separator style="-fx-background-color: #334155;"/>

    <Label text="Métodos de pago disponibles: Tarjeta, Nequi, Daviplata"
           style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;"/>

    <Button text="Volver" onAction="#volver"
            style="-fx-background-color: #475569; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 8;"/>

</VBox>