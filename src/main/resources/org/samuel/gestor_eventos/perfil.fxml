<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.samuel.gestor_eventos.controler.PerfilController"
      prefWidth="600"
      prefHeight="500"
      stylesheets="@admin.css">

    <Label text="Mi Perfil"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <VBox spacing="10"
          style="-fx-background-color: #1e293b; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #334155; -fx-border-radius: 15;">
        <Label fx:id="lblNombre" style="-fx-text-fill: #e2e8f0; -fx-font-size: 16px;"/>
        <Label fx:id="lblCorreo" style="-fx-text-fill: #e2e8f0; -fx-font-size: 16px;"/>
        <Label fx:id="lblTelefono" style="-fx-text-fill: #e2e8f0; -fx-font-size: 16px;"/>
    </VBox>

    <Separator style="-fx-background-color: #334155;"/>

    <Label text="Métodos de Pago"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <ListView fx:id="listMetodosPago" prefWidth="300" prefHeight="150"
              style="-fx-background-color: #1e293b; -fx-background-radius: 10; -fx-border-color: #334155; -fx-border-radius: 10;">
        <style>
            .list-cell {
            -fx-background-color: #1e293b;
            -fx-text-fill: #e2e8f0;
            -fx-font-size: 14px;
            -fx-padding: 8;
            }
            .list-cell:selected {
            -fx-background-color: #3b82f6;
            -fx-text-fill: white;
            }
        </style>
    </ListView>

    <HBox spacing="10" alignment="CENTER">
        <TextField fx:id="txtNuevoMetodo" promptText="Nuevo método de pago"
                   style="-fx-background-color: #334155; -fx-text-fill: white; -fx-padding: 8; -fx-background-radius: 8;"/>
        <Button text="Agregar" onAction="#agregarMetodo"
                style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 8;"/>
        <Button text="Eliminar" onAction="#eliminarMetodo"
                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 8;"/>
    </HBox>

    <Label fx:id="lblMensaje" style="-fx-text-fill: #60a5fa; -fx-font-size: 12px;"/>

    <Button text="Volver" onAction="#volver"
            style="-fx-background-color: #475569; -fx-text-fill: white; -fx-padding: 8 20; -fx-background-radius: 8;"/>

</VBox>