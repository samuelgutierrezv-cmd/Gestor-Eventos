<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<VBox alignment="CENTER" spacing="15" stylesheets="@registro.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.samuel.gestor_eventos.controler.RegistroController"
      prefHeight="600.0" prefWidth="450.0">

<VBox styleClass="card" spacing="10" maxWidth="350">

    <Label text="Registro" styleClass="label-title"/>

    <TextField fx:id="nombreField" promptText="Nombre completo"/>

    <TextField fx:id="emailField" promptText="Correo Gmail"/>

    <PasswordField fx:id="passwordField" promptText="Contraseña"/>

    <TextField fx:id="telefonoField" promptText="Número de teléfono"/>

    <ComboBox fx:id="metodoPagoBox" promptText="Método de pago">
        <items>
            <FXCollections fx:factory="observableArrayList">
                <String fx:value="Tarjeta de crédito"/>
                <String fx:value="Nequi"/>
                <String fx:value="Daviplata"/>
                <String fx:value="Efectivo"/>
            </FXCollections>
        </items>
    </ComboBox>

    <Button text="Registrarse" styleClass="button-primary" onAction="#registrar"/>

    <Button text="Volver al login" styleClass="button-secondary" onAction="#volverLogin"/>

</VBox>

</VBox>