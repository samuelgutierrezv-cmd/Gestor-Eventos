<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.control.PasswordField?>
<VBox prefHeight="550.0" prefWidth="700.0" styleClass="pane-principal" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.samuel.gestor_eventos.controler.LoginControler" stylesheets="@login.css" >
    <VBox styleClass="card" spacing="10" maxWidth="300">

        <Label text="Iniciar Sesión" styleClass="label-title"/>

        <TextField fx:id="emailField" promptText="Correo Gmail"/>

        <PasswordField fx:id="passwordField" promptText="Contraseña"/>

        <Button text="Ingresar" styleClass="button-primary" onAction="#login"/>

        <Button text="Crear cuenta" styleClass="button-secondary" onAction="#irRegistro"/>

        <Button text="Ingresar como Administrador" styleClass="button-secondary" onAction="#loginAdministrador"/>

    </VBox>

</VBox>
