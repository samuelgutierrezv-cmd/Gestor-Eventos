<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.samuel.gestor_eventos.controler.FacturaController"
        spacing="20"
        alignment="TOP_CENTER"
        prefWidth="700"
        prefHeight="600"
        style="-fx-background-color: #111827; -fx-padding: 35;">

    <!-- TITULO -->
    <Label
            text="FACTURA ELECTRÓNICA"
            style="
                -fx-font-size: 28px;
                -fx-font-weight: bold;
                -fx-text-fill: white;
            "/>

    <!-- TARJETA -->
    <VBox
            spacing="18"
            maxWidth="500"
            style="
                -fx-background-color: #1f2937;
                -fx-padding: 30;
                -fx-background-radius: 18;
            ">

        <HBox spacing="10">
            <Label text="ID Factura:"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 15px;"/>
            <Label fx:id="lblFacturaId"
                   style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Cliente:"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 15px;"/>
            <Label fx:id="lblCliente"
                   style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Evento:"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 15px;"/>
            <Label fx:id="lblEvento"
                   style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Monto:"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 15px;"/>
            <Label fx:id="lblMonto"
                   style="
                        -fx-text-fill: #22c55e;
                        -fx-font-size: 18px;
                        -fx-font-weight: bold;
                   "/>
        </HBox>

        <HBox spacing="10">
            <Label text="Método de Pago:"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 15px;"/>
            <Label fx:id="lblMetodoPago"
                   style="-fx-text-fill: white; -fx-font-size: 15px;"/>
        </HBox>

        <HBox spacing="10">
            <Label text="Estado Compra:"
                   style="-fx-text-fill: #9ca3af; -fx-font-size: 15px;"/>
            <Label fx:id="lblEstadoCompra"
                   style="
                        -fx-text-fill: #60a5fa;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                   "/>
        </HBox>

    </VBox>

    <!-- BOTONES -->
    <HBox spacing="15" alignment="CENTER">

        <Button
                fx:id="btnDescargarPDF"
                text="Descargar PDF"
                onAction="#descargarPDF"
                style="
                    -fx-background-color: #dc2626;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 12;
                    -fx-padding: 12 18;
                "/>

        <Button
                fx:id="btnDescargarCSV"
                text="Descargar CSV"
                onAction="#descargarCSV"
                style="
                    -fx-background-color: #16a34a;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 12;
                    -fx-padding: 12 18;
                "/>

        <Button
                fx:id="btnVolver"
                text="Volver"
                onAction="#volver"
                style="
                    -fx-background-color: #374151;
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 12;
                    -fx-padding: 12 18;
                "/>

    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

</VBox>