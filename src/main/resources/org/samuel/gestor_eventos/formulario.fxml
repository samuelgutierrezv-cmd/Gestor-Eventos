<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane fitToWidth="true" fitToHeight="true"
            styleClass="pane-principal"
            stylesheets="@admin.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.samuel.gestor_eventos.controler.FormularioControler">
    <content>
        <VBox spacing="12"
              alignment="CENTER"
              prefHeight="700.0"
              prefWidth="700.0"
              styleClass="body-bg">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label fx:id="lblTitulo" text="Formulario" styleClass="header-title"/>
            <VBox fx:id="contenedorCampos" spacing="10"/>
            <Button text="Guardar" onAction="#guardar" styleClass="btn-accion"/>
        </VBox>
    </content>
</ScrollPane>