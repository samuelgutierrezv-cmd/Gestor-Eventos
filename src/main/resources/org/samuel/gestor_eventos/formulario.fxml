<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12"
      alignment="CENTER"
      prefHeight="700.0"
      prefWidth="700.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.samuel.gestor_eventos.controler.FormularioControler">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="lblTitulo" text="Formulario" style="-fx-font-size:18px; -fx-text-fill:#ffffff;"/>

    <VBox fx:id="contenedorCampos" spacing="10"/>

    <Button text="Guardar" onAction="#guardar"
            style="-fx-background-color:#3b82f6; -fx-text-fill:white;"/>

</VBox>