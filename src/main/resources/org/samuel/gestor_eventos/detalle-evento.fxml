<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane
        fitToWidth="true"
        fitToHeight="true"
        style="-fx-background-color: transparent; -fx-background: transparent;"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.samuel.gestor_eventos.controler.DetalleEventoController">

    <content>
        <VBox spacing="15"
              alignment="TOP_CENTER"
              prefWidth="800"
              prefHeight="700"
              style="-fx-padding: 30; -fx-background-color: #0f172a;">

            <Label fx:id="nombreLabel"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Label fx:id="categoriaLabel" style="-fx-text-fill: #94a3b8;"/>
            <Label fx:id="fechaLabel" style="-fx-text-fill: #94a3b8;"/>
            <Label fx:id="ciudadLabel" style="-fx-text-fill: #94a3b8;"/>
            <Label fx:id="estadoLabel" style="-fx-text-fill: #94a3b8;"/>

            <Label fx:id="descripcionLabel"
                   wrapText="true"
                   prefWidth="600"
                   style="-fx-text-fill: #e2e8f0; -fx-font-size: 14px;"/>

            <Separator style="-fx-background-color: #334155;"/>

            <Label text="Recinto"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label fx:id="recintoLabel" style="-fx-text-fill: #94a3b8;"/>

            <Label text="Zonas disponibles"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <!-- ListView con tamaño controlado -->
            <ListView fx:id="zonasListView"
                      prefHeight="200"
                      prefWidth="550"
                      maxWidth="600"
                      style="-fx-background-color: #1e293b; -fx-background-radius: 10;">
                <style>
                    .list-cell {
                    -fx-background-color: #1e293b;
                    -fx-text-fill: #e2e8f0;
                    -fx-font-size: 14px;
                    -fx-padding: 10;
                    }
                    .list-cell:filled:selected {
                    -fx-background-color: #3b82f6;
                    -fx-text-fill: white;
                    }
                </style>
            </ListView>

            <HBox spacing="15" alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                <Button text="Comprar entradas"
                        onAction="#comprarEntradas"
                        style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                <Button text="Ver Notificaciones"
                        onAction="#verNotificaciones"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8;"/>
                <Button text="Volver"
                        onAction="#volver"
                        style="-fx-background-color: #475569; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8;"/>
            </HBox>

        </VBox>
    </content>
</ScrollPane>