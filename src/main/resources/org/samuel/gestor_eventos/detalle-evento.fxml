<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox
        spacing="15"
        alignment="TOP_CENTER"
        prefWidth="800"
        prefHeight="650"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.samuel.gestor_eventos.controler.DetalleEventoController"
        style="-fx-padding: 30;">

    <Label fx:id="nombreLabel"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label fx:id="categoriaLabel"/>

    <Label fx:id="fechaLabel"/>

    <Label fx:id="ciudadLabel"/>

    <Label fx:id="estadoLabel"/>

    <Label fx:id="descripcionLabel"
           wrapText="true"
           prefWidth="600"/>

    <Separator/>

    <Label text="Recinto"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label fx:id="recintoLabel"/>

    <Label text="Zonas disponibles"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ListView fx:id="zonasListView"
              prefHeight="200"
              prefWidth="500"/>

    <HBox spacing="15" alignment="CENTER">

        <Button text="Comprar entradas"
                onAction="#comprarEntradas"/>

        <Button text="Volver"
                onAction="#volver"/>

    </HBox>

</VBox>