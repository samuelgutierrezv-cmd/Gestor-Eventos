<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.samuel.gestor_eventos.controler.IncidenciasController"
      prefWidth="900"
      prefHeight="650"
      stylesheets="@admin.css">

    <Label text="Gestión de Incidencias"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <HBox spacing="15" alignment="CENTER">
        <Button text="🔄 Refrescar"
                onAction="#refrescar"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8;"/>
        <Button text="➕ Crear Incidencia"
                onAction="#crearIncidencia"
                style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <content>
            <TableView fx:id="tablaIncidencias" prefWidth="850" prefHeight="450">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120"/>
                    <TableColumn fx:id="colEntidad" text="Entidad Afectada" prefWidth="150"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="300"/>
                </columns>
            </TableView>
        </content>
    </ScrollPane>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Volver" onAction="#volver" styleClass="btn-volver"/>
    </HBox>

</VBox>